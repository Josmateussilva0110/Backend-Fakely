ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
RELOAD=true
POSTGRES_USER=fakenews
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fakenews
DATABASE_URL=postgresql+psycopg://fakenews:change-me@localhost:5432/fakenews
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:5173"]

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_CREATE=10/minute
RATE_LIMIT_STORAGE_URI=memory://

ANALYSIS_VERSION=evidence-rules-1
MIN_WORDS=5
MAX_TEXT_LENGTH=100000

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

ANALYSIS_CACHE_TTL_SECONDS=3600
ANALYSIS_CACHE_MAX_ENTRIES=1024

# Busca de evidências
VERIFICATION_ENABLED=true
VERIFICATION_TIMEOUT_SECONDS=5
VERIFICATION_TOTAL_TIMEOUT_SECONDS=12
VERIFICATION_MAX_RESULTS=5
VERIFICATION_MAX_KEYWORDS=4
# Opcional: chave da Google Fact Check Tools API (sem chave, o provedor fica desativado)
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_FACT_CHECK_LANGUAGE_CODE=pt-BR

# Critérios de decisão (calibre com exemplos reais)
EVIDENCE_MIN_RELEVANCE=0.5
DECISION_MIN_RELEVANCE=0.7
DECISION_MIN_SUPPORTING_SOURCES=1
DECISION_MIN_CONTRADICTING_SOURCES=1
EVIDENCE_OUTDATED_AFTER_DAYS=730

# Leitura da página quando só a URL é enviada
PAGE_FETCH_ENABLED=true
PAGE_FETCH_TIMEOUT_SECONDS=8
PAGE_FETCH_MAX_BYTES=3000000
PAGE_FETCH_MAX_REDIRECTS=3
